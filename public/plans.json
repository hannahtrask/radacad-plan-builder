  "explain": {
    "icl": {
      "title": "What is ICL Academy?",
      "body": "ICL Academy is an accredited online school and a RadAcad partner. It follows a traditional, independent model: students take full online courses with ICL teachers and do their coursework here at RadAcad, with a coach keeping them on track. Families can enroll full time through RadAcad, or add up to three ICL courses to their own plan."
    },
    "aeon": {
      "title": "What is Aeon School?",
      "body": "Aeon is a project-based, mastery-focused online school and a RadAcad partner. It runs seminar-style classes that emphasize deep learning, critical thinking, and interdisciplinary work, and it’s aimed at students headed for selective colleges. Students take Aeon classes here, with daily structure and in-person guidance from RadAcad."
    }
  },
